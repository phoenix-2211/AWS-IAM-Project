{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecurityRule List Schema v0.1",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "rule_id",
      "title",
      "description",
      "principal_type",
      "action",
      "resource_type",
      "relationship",
      "severity",
      "version",
      "status"
    ],
    "properties": {
      "rule_id": { "type": "string" },
      "title": { "type": "string" },
      "description": { "type": "string" },
      "condition": { "type": ["object", "null"] },
      "principal_type": { "type": "string" },
      "action": { "type": "string" },
      "resource_type": { "type": "string" },
      "relationship": { "type": "string" },
      "severity": {
        "type": "string",
        "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
      },
      "source": { "type": "object" },
      "evidence": { "type": ["string", "object"] },
      "mitre": { "type": ["object", "null"] },
      "version": { "type": "string" },
      "status": {
        "type": "string",
        "enum": ["ACTIVE", "DISABLED", "DRAFT"]
      },
      "rulebook_origin": { "type": "string" }
    },
    "additionalProperties": true
  }
}
